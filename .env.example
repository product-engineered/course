# Beehiiv
#
# Copy this file to .env.local and fill in real values locally.
# Never commit .env.local or real API keys.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=pub_00000000-0000-0000-0000-000000000000
BEEHIIV_AUTOMATION_IDS=aut_00000000-0000-0000-0000-000000000000

# Optional Beehiiv behavior.
# Allowed double opt-in values: on, off, not_set. Leave blank to use publication default.
BEEHIIV_DOUBLE_OPT_OVERRIDE=
BEEHIIV_REACTIVATE_EXISTING=false
BEEHIIV_SEND_WELCOME_EMAIL=false
BEEHIIV_UTM_SOURCE=course-landing
BEEHIIV_UTM_MEDIUM=website
BEEHIIV_UTM_CAMPAIGN=waitlist
